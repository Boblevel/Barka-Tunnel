<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BarkaTunnel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/BarkaFlatButton</item>
        <item name="buttonStyle">@style/BarkaFlatButton</item>
        <item name="barkaAccent">@color/barka_blue</item>
        <item name="barkaAccentLight">@color/barka_blue_light</item>
        <item name="android:statusBarColor">@color/barka_background</item>
        <item name="android:navigationBarColor">@color/barka_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.BarkaTunnel.Starting" parent="Theme.BarkaTunnel">
        <item name="android:windowBackground">@drawable/barka_starting_window</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

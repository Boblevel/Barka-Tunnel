    <string name="guide_title">USER GUIDE</string>
    <string name="guide_1_title">1. Introduction                                      ⌄</string>
    <string name="guide_1_text">Discover Barka Tunnel and the main elements on the home screen.</string>
    <string name="guide_2_title">2. Choose a network                              ⌄</string>
    <string name="guide_2_text">Select MOOV-AFRICA BF, ORANGE BF, or TELECEL BF according to your network.</string>
    <string name="guide_3_title">3. IP Finder                                           ⌄</string>
    <string name="guide_3_text">Enter a pattern, set Barka Tunnel as the assistant, then search for a new mobile IP.</string>
    <string name="guide_4_title">4. Subscription                                      ⌄</string>
    <string name="guide_4_text">Choose an offer, then tap PAY to receive your code after payment.</string>
    <string name="guide_5_title">5. Activation code                              ⌄</string>
    <string name="guide_5_text">Copy the code received after payment, paste it under Activation code, then tap ACTIVATE.</string>
    <string name="guide_6_title">6. Connection                                         ⌄</string>
    <string name="guide_6_text">On the home screen, use the center button to start or stop the VPN connection.</string>
    <string name="guide_7_title">7. Journal                                              ⌄</string>
    <string name="guide_7_text">View pending, refused, successful connections and disconnections.</string>
    <string name="guide_8_title">8. Settings                                        ⌄</string>
    <string name="guide_8_text">Customize the language and theme, check permissions and updates, and access support.</string>


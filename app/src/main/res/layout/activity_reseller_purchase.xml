<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/barka_background" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="40dp" android:paddingEnd="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">

            <ImageView android:id="@+id/resellerBackButton" android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="@string/back" android:padding="10dp" android:src="@drawable/ic_back_barka"/>

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/reseller_title" android:textColor="@color/barka_blue" android:textSize="21sp" android:textStyle="bold"/>

            <View android:layout_width="46dp" android:layout_height="46dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/reseller_choose" android:textColor="@color/barka_text" android:textSize="15sp" android:textStyle="bold"/>

        <RadioGroup android:id="@+id/resellerPlans" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:checkedButton="@id/resellerMonth">

            <RadioButton android:id="@+id/resellerMonth" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_network_selected" android:buttonTint="@color/barka_blue" android:checked="true" android:paddingHorizontal="16dp" android:text="@string/reseller_month" android:textColor="@color/barka_text" android:textSize="14sp" android:textStyle="bold" android:minHeight="72dp" android:paddingVertical="14dp"/>

            <RadioButton android:id="@+id/resellerTwoMonths" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_network_selected" android:buttonTint="@color/barka_blue" android:paddingHorizontal="16dp" android:text="@string/reseller_two_months" android:textColor="@color/barka_text" android:textSize="14sp" android:textStyle="bold" android:minHeight="72dp" android:paddingVertical="14dp"/>

            </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_network_selected" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/subscription_secure_payment" android:textColor="@color/barka_blue" android:textSize="12sp" android:textStyle="bold"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/reseller_help" android:textColor="@color/barka_text_secondary" android:textSize="13sp"/>



            <com.google.android.material.button.MaterialButton android:id="@+id/resellerPay" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="@string/subscription_pay" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/barka_blue" app:cornerRadius="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/reseller_after_payment" android:textColor="@color/barka_text_secondary" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/resellerStatusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_network_selected" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text" android:textSize="14sp" android:id="@+id/resellerStatus"/></LinearLayout><LinearLayout android:id="@+id/resellerCredentialsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_network_selected" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_blue" android:textSize="18sp" android:textStyle="bold" android:text="@string/reseller_credentials"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text_secondary" android:textSize="12sp" android:layout_marginTop="14dp" android:text="@string/reseller_link"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text" android:textSize="14sp" android:textIsSelectable="true" android:textStyle="bold" android:layout_marginTop="4dp" android:id="@+id/resellerLink"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text_secondary" android:textSize="12sp" android:layout_marginTop="14dp" android:text="@string/reseller_username"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text" android:textSize="14sp" android:textIsSelectable="true" android:textStyle="bold" android:layout_marginTop="4dp" android:id="@+id/resellerUsername"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text_secondary" android:textSize="12sp" android:layout_marginTop="14dp" android:text="@string/reseller_password"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text" android:textSize="14sp" android:textIsSelectable="true" android:textStyle="bold" android:layout_marginTop="4dp" android:id="@+id/resellerPassword"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text_secondary" android:textSize="12sp" android:layout_marginTop="14dp" android:text="@string/reseller_expiry"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/barka_text" android:textSize="14sp" android:textIsSelectable="true" android:textStyle="bold" android:layout_marginTop="4dp" android:id="@+id/resellerExpiry"/><com.google.android.material.button.MaterialButton android:id="@+id/resellerCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/reseller_copy" android:textStyle="bold" android:textColor="@color/white" app:cornerRadius="12dp" app:backgroundTint="@color/barka_blue"/></LinearLayout></LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settingsFixedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/barka_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/settingsBackButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_back_barka" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/settings_title"
                android:textColor="@color/barka_blue"
                android:textSize="21sp"
                android:textStyle="bold" />

            <View
                android:layout_width="46dp"
                android:layout_height="46dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="0dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_settings_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_logo_white_circle"
                    android:contentDescription="@string/barka_logo_description"
                    android:padding="6dp"
                    android:src="@drawable/ic_barka_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/barka_card"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/version_format"
                        android:textColor="#D8E8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_general"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_theme_format"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"

                app:icon="@drawable/ic_theme_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/languageButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_language_format"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"

                app:icon="@drawable/ic_language_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_connection"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_network_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/settings_auto_ping"
                    android:src="@drawable/ic_ping_barka" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_auto_ping"
                        android:textColor="@color/barka_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_auto_ping_summary"
                        android:textColor="@color/barka_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoPingSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vpnSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_android_vpn"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"

                app:icon="@drawable/ic_vpn_settings_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_tools"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdateButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_check_update"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"

                app:icon="@drawable/ic_refresh_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareAppButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_share_app"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_share_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/telegramChannelButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="@string/settings_telegram_channel"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"

                app:icon="@drawable/ic_telegram_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_about"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_network_selected"
                android:padding="18dp"
                android:text="@string/app_name"
                android:textColor="@color/barka_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>

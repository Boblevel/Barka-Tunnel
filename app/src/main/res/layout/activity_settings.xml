<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/settingsBackButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:clickable="true"
                    android:contentDescription="Retour"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_barka" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="PARAMÈTRES"
                    android:textColor="@color/barka_blue"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="46dp"
                    android:layout_height="46dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_menu_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_logo_white_circle"
                    android:contentDescription="Logo Barka Tunnel"
                    android:padding="6dp"
                    android:src="@drawable/ic_barka_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barka Tunnel"
                        android:textColor="@color/barka_card"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Version"
                        android:textColor="#D8E8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GÉNÉRAL"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_network_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Afficher les notifications"
                        android:textColor="@color/barka_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Recevoir les informations importantes"
                        android:textColor="@color/barka_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/notificationsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Thème • Clair"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CONNEXION"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settingsIpValue"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_network_selected"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Adresse IP : Indisponible"
                android:textColor="@color/barka_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vpnSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Réglages VPN Android"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OUTILS"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Autorisations de l’application"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdateButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Vérifier la mise à jour"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareAppButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Partager l’application"
                android:textAllCaps="false"
                android:textColor="@color/barka_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/barka_card"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_share_barka"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/barka_blue"
                app:strokeColor="@color/barka_border"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="À PROPOS"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_network_selected"
                android:padding="18dp"
                android:text="Barka Tunnel"
                android:textColor="@color/barka_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/barka_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/barka_card"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Accueil"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Accueil"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Journal"
                android:src="@drawable/ic_nav_journal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Journal"
                android:textColor="@color/barka_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

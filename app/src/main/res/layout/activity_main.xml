<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="40dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="Logo Barka Tunnel"
                        android:src="@drawable/ic_barka_logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Barka"
                            android:maxLines="1"
                            android:textColor="@color/barka_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Tunnel"
                            android:maxLines="1"
                            android:textColor="@color/barka_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/buttonFreeTrial"
                    android:layout_width="56dp"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Essai gratuit"
                        android:src="@drawable/ic_gift_barka"
                        android:tint="@color/barka_red" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/buttonRefresh"
                    android:layout_width="56dp"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Vérifier les mises à jour"
                        android:src="@drawable/ic_refresh_barka" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/buttonMenu"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:contentDescription="Ouvrir le menu"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_menu_barka" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/networkIpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_final"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP DU RÉSEAU"
                        android:textColor="@color/barka_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkIpValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Indisponible"
                        android:textColor="@color/barka_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkIpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Adresse IP actuelle"
                        android:textColor="@color/barka_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/networkTransportIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Type de réseau"
                    android:src="@drawable/ic_wifi_barka" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RÉSEAU"
                android:textColor="@color/barka_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/networkSelector"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_final"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/networkLogo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo de l’opérateur sélectionné"
                    android:scaleType="fitCenter"
                    android:src="@drawable/moov_africa_official" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RÉSEAU SÉLECTIONNÉ"
                        android:textColor="@color/barka_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/networkName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOOV-AFRICA BF"
                            android:textColor="@color/barka_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Burkina Faso"
                            android:src="@drawable/ic_flag_bf" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/networkSubtitle"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:text="Réseau sélectionné"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/barka_blue"
                    android:textSize="32sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/powerButton"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_power_final"
                android:elevation="5dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/barka_blue"
                android:textSize="58sp" />

            <TextView
                android:id="@+id/vpnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="NON CONNECTÉ"
                android:textColor="@color/barka_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Temps de connexion : 00:00:00"
                android:textColor="@color/barka_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_final"
                android:gravity="center_vertical"
                android:minHeight="116dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:contentDescription="Temps restant"
                    android:padding="10dp"
                    android:src="@drawable/ic_clock_barka" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPS RESTANT"
                        android:textColor="@color/barka_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accessRemainingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="00:00:00"
                        android:textColor="@color/barka_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accessStatus"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:text=""
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addAccessButton"
                    android:layout_width="116dp"
                    android:layout_height="48dp"
                    android:text="AJOUTER"
                    android:textStyle="bold"
                    app:backgroundTint="@color/barka_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="SE CONNECTER"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/pageBottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/barka_border" />

    <LinearLayout
        android:id="@+id/pageBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/barka_card"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Accueil"
                android:src="@drawable/ic_nav_home_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Accueil"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Journal"
                android:src="@drawable/ic_nav_journal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Journal"
                android:textColor="@color/barka_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/navIpFinder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonMenu"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="@color/barka_text"
                    android:textSize="22sp" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Logo Barka Tunnel"
                    android:src="@drawable/ic_barka_logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="BARKA TUNNEL"
                    android:textColor="@color/barka_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonFreeTrial"
                    android:layout_width="48dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="🎁\n1H"
                    android:textColor="@color/barka_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonRefresh"
                    android:layout_width="62dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="↻\nMise à jour"
                    android:textColor="@color/barka_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_final"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP DU RÉSEAU"
                        android:textColor="@color/barka_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkIpValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Indisponible"
                        android:textColor="@color/barka_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkIpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Adresse IP actuelle"
                        android:textColor="@color/barka_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="@color/barka_blue"
                    android:textSize="23sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/networkSelector"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_final"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/networkLogo"
                    android:layout_width="62dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo de l’opérateur sélectionné"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_operator_moov" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RÉSEAU SÉLECTIONNÉ"
                        android:textColor="@color/barka_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="MOOV-AFRICA BF 🇧🇫"
                        android:textColor="@color/barka_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/networkSubtitle"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:text="Réseau sélectionné" />
                </LinearLayout>

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/barka_blue"
                    android:textSize="32sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/powerButton"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_power_final"
                android:elevation="5dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/barka_blue"
                android:textSize="58sp" />

            <TextView
                android:id="@+id/vpnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="NON CONNECTÉ"
                android:textColor="@color/barka_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Temps de connexion : 00:00:00"
                android:textColor="@color/barka_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_final"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="◷"
                    android:textColor="@color/barka_blue"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPS RESTANT"
                        android:textColor="@color/barka_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accessRemainingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="00:00:00"
                        android:textColor="@color/barka_text"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accessStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En attente d’activation"
                        android:textColor="@color/barka_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:text="SE CONNECTER" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/barka_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="Accueil"
                android:src="@drawable/ic_nav_home_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Accueil"
                android:textColor="@color/barka_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="Journal"
                android:src="@drawable/ic_nav_journal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Journal"
                android:textColor="@color/barka_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/navIpFinder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

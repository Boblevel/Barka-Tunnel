<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:background="@color/barka_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/barka_logo_description"
                android:src="@drawable/ic_barka_logo" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/menu_all_services" android:textColor="@color/barka_text"
                    android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/menuVersion"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="@string/version_format"
                    android:textColor="@color/barka_text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/menuClose"
                android:layout_width="42dp" android:layout_height="42dp"
                android:gravity="center" android:contentDescription="@string/back"
                android:text="✕" android:textSize="21sp" android:textColor="@color/barka_text"
                android:background="@drawable/bg_menu_active" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/menuHome"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_home_line"
                android:drawableTint="@color/barka_blue"
                android:background="@drawable/bg_menu_active"
                android:text="@string/home" />

            <TextView style="@style/BarkaMenuSection" android:text="@string/menu_section_access" />

            <TextView
                android:id="@+id/menuGuide"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_book_line"
                android:drawableTint="@color/barka_green"
                android:text="@string/menu_guide" />

            <TextView
                android:id="@+id/menuSubscription"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_card_line"
                android:drawableTint="@color/barka_orange"
                android:text="@string/menu_subscription" />

            <TextView
                android:id="@+id/menuActivation"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_key_line"
                android:drawableTint="@color/barka_blue"
                android:text="@string/menu_activation_code" />

            <TextView style="@style/BarkaMenuSection" android:text="@string/menu_section_tools" />

            <TextView
                android:id="@+id/menuIpFinder"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_ip_finder"
                android:drawableTint="@color/barka_green"
                android:text="@string/menu_ip_finder" />

            <TextView
                android:id="@+id/menuSettings"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_settings_line"
                android:drawableTint="@color/barka_blue"
                android:text="@string/menu_settings" />

            <TextView style="@style/BarkaMenuSection" android:text="@string/menu_section_community" />

            <TextView
                android:id="@+id/menuReseller"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_person_line"
                android:drawableTint="@color/barka_orange"
                android:text="@string/reseller_title" />

            <TextView
                android:id="@+id/menuSupport"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_support_line"
                android:drawableTint="@color/barka_red"
                android:text="@string/menu_support" />

            <TextView
                android:id="@+id/menuSuggestions"
                style="@style/BarkaMenuItem"
                android:drawableStart="@drawable/ic_menu_suggestions"
                android:drawableTint="@color/barka_blue"
                android:text="@string/suggestions_title" />

            <View
                android:id="@+id/menuJournal"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

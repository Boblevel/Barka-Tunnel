<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sideMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/sideMenuPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/barka_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sideMenuHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_header"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="22dp"
            android:paddingEnd="26dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_logo_white_circle"
                android:contentDescription="Logo Barka Tunnel"
                android:padding="7dp"
                android:src="@drawable/ic_barka_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Barka Tunnel"
                android:textColor="@color/barka_card"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Version 1.0"
                android:textColor="#D8E8FF"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/sideMenuContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/menuHome"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_home_line"
                    android:text="Accueil" />

                <TextView
                    android:id="@+id/menuGuide"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_book_line"
                    android:text="Guide d’utilisation" />

                <TextView
                    android:id="@+id/menuSubscription"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_card_line"
                    android:text="Abonnement" />

                <TextView
                    android:id="@+id/menuActivation"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_key_line"
                    android:text="Code d’activation" />

                <TextView
                    android:id="@+id/menuSettings"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_settings_line"
                    android:text="Paramètres" />

                <TextView
                    android:id="@+id/menuSupport"
                    style="@style/BarkaMenuItem"
                    android:drawableStart="@drawable/ic_menu_support_line"
                    android:text="Contacter le support" />

                <View
                    android:id="@+id/menuJournal"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/menuIpFinder"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

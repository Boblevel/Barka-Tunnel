<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_final"
    android:overScrollMode="never"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_confirmed"
            android:textColor="@color/barka_blue"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/payment_purchased_subscription"
            android:textColor="@color/barka_text_secondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/paymentConfirmedOffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/barka_text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/payment_code_ready"
            android:textColor="@color/barka_text_secondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/paymentConfirmedCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_final"
            android:padding="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/barka_text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/payment_keep_code_private"
            android:textColor="@color/barka_text_secondary"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/paymentConfirmActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/payment_activate_now"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/barka_blue"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/paymentConfirmCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/copy_code"
            android:textColor="@color/barka_blue"
            android:textSize="14sp"
            app:strokeColor="@color/barka_blue"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>

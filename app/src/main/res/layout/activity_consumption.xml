<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/barka_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="40dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/consumptionBack" android:layout_width="46dp" android:layout_height="46dp" android:padding="10dp" android:src="@drawable/ic_back_barka" android:contentDescription="@string/back" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/consumption_title" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/barka_blue" />
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp" android:src="@drawable/ic_consumption_barka" android:importantForAccessibility="no" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_network_selected">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_total" android:textSize="13sp" android:textColor="@color/barka_text" />
                <TextView android:id="@+id/consumptionTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_zero" android:textSize="34sp" android:textColor="@color/barka_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_summary" android:textSize="13sp" android:textColor="@color/barka_text" />
                <TextView android:id="@+id/consumptionDirections" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_initial_directions" android:textSize="13sp" android:textColor="@color/barka_text" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_network_selected">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_days" android:textSize="13sp" android:textColor="@color/barka_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_today" android:textSize="17sp" android:textColor="@color/barka_text" />
                <TextView android:id="@+id/consumptionToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_zero" android:textSize="28sp" android:textColor="@color/barka_text" />
                <ProgressBar android:id="@+id/consumptionTodayBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/barka_blue" android:progressBackgroundTint="@color/barka_border" android:max="100" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_yesterday" android:textSize="17sp" android:textColor="@color/barka_text" />
                <TextView android:id="@+id/consumptionYesterday" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_zero" android:textSize="28sp" android:textColor="@color/barka_text" />
                <ProgressBar android:id="@+id/consumptionYesterdayBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/barka_blue" android:progressBackgroundTint="@color/barka_border" android:max="100" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/consumptionSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/consumption_save" android:textAllCaps="false" android:textColor="@color/barka_text" app:backgroundTint="@color/barka_card" app:strokeColor="@color/barka_border" app:strokeWidth="1dp" app:cornerRadius="14dp" app:icon="@drawable/ic_share_barka" app:iconTint="@color/barka_blue" />
            <com.google.android.material.button.MaterialButton android:id="@+id/consumptionRestore" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/consumption_restore" android:textAllCaps="false" android:textColor="@color/barka_text" app:backgroundTint="@color/barka_card" app:strokeColor="@color/barka_border" app:strokeWidth="1dp" app:cornerRadius="14dp" app:icon="@drawable/ic_refresh_barka" app:iconTint="@color/barka_blue" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/consumption_backup_help" android:textSize="13sp" android:textColor="@color/barka_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
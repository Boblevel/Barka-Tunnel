<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/networkDialogClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/barka_text"
            android:textSize="34sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CHOISIR UN RÉSEAU"
            android:textColor="@color/barka_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionMoov"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="46dp"
            android:contentDescription="Moov Africa"
            android:scaleType="centerInside"
            android:src="@drawable/ic_operator_moov" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="MOOV-AFRICA BF 🇧🇫"
            android:textColor="@color/barka_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/optionMoovCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="●"
            android:textColor="@color/barka_blue"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionOrange"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="46dp"
            android:contentDescription="Orange BF"
            android:scaleType="centerInside"
            android:src="@drawable/ic_operator_orange" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="ORANGE BF 🇧🇫"
            android:textColor="@color/barka_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/optionOrangeCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/barka_text_secondary"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionTelecel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="46dp"
            android:contentDescription="Telecel BF"
            android:scaleType="centerInside"
            android:src="@drawable/ic_operator_telecel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="TELECEL BF 🇧🇫"
            android:textColor="@color/barka_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/optionTelecelCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/barka_text_secondary"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>

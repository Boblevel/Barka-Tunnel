<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barka_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="40dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/networkDialogClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back_barka" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/choose_network"
            android:textColor="@color/barka_blue"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionMoov"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Moov Africa"
            android:scaleType="fitCenter"
            android:src="@drawable/moov_africa_official" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="MOOV-AFRICA BF"
            android:textColor="@color/barka_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="15dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/burkina_faso"
            android:src="@drawable/ic_flag_bf" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="15dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/niger"
            android:src="@drawable/ic_flag_ne" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="15dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/togo"
            android:src="@drawable/ic_flag_tg" />

        <TextView
            android:id="@+id/optionMoovCheck"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/barka_blue"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionOrange"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Orange BF"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_operator_orange" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="ORANGE BF"
            android:textColor="@color/barka_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/burkina_faso"
            android:src="@drawable/ic_flag_bf" />

        <TextView
            android:id="@+id/optionOrangeCheck"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/barka_text_secondary"
            android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionTelecel"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_final"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Telecel BF"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_operator_telecel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="TELECEL BF"
            android:textColor="@color/barka_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/burkina_faso"
            android:src="@drawable/ic_flag_bf" />

        <TextView
            android:id="@+id/optionTelecelCheck"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/barka_text_secondary"
            android:textSize="25sp" />
    </LinearLayout>
</LinearLayout>

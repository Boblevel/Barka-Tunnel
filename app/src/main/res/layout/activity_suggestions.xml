<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/barka_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:paddingTop="48dp">
        <ImageButton android:id="@+id/suggestionBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp" android:src="@drawable/ic_back_barka"
            android:contentDescription="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/suggestions_title" android:textColor="@color/barka_text" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/suggestions_intro" android:textColor="@color/barka_text_secondary" />
        <TextView android:id="@+id/suggestionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite"
            android:text="@string/suggestions_checking" android:textColor="@color/barka_text" />
        <EditText android:id="@+id/suggestionMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:hint="@string/suggestions_hint"
            android:gravity="top|start" android:minLines="6" android:maxLength="2000"
            android:inputType="textMultiLine|textCapSentences" android:textColor="@color/barka_text" android:textColorHint="@color/barka_text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/suggestionSend"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/suggestions_send" android:enabled="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/suggestionRefresh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/suggestions_retry" />
    </LinearLayout>
</ScrollView>

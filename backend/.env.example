# Barka Tunnel Backend
APP_ENV=production
HOST=0.0.0.0
PORT=8085

# URL publique HTTPS du backend, sans slash final.
# Exemple: https://api.mondomaine.com
PUBLIC_BASE_URL=https://api.example.com

# Base SQLite persistante
DATABASE_PATH=/app/data/barka.db

# Générés automatiquement par scripts/setup_env.sh si laissés ainsi
CODE_SECRET=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME

# LomoPay — à récupérer depuis votre espace API.
# NE JAMAIS placer la clé secrète dans l'APK Android.
LOMOPAY_PUBLIC_KEY=
LOMOPAY_SECRET_KEY=
LOMOPAY_API_BASE=https://lomopay.net/api/v1

# CORS n'est pas nécessaire pour l'app Android native.
# Mettre * uniquement si un futur panneau web public l'exige.
CORS_ORIGINS=
